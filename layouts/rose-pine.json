{
  "id": "root",
  "type": "row",
  "theme": "graphite",
  "colors": {
    "foreground": "#e0def4",
    "canvas": "#191724",
    "chrome": "#1f1d2e",
    "popover": "#26233a",
    "raised": "#26233a",
    "hover": "#26233a",
    "selected": "#403d52",
    "border": "#26233a",
    "input": "#403d52",
    "muted": "#908caa",
    "dim": "#6e6a86",
    "accent": "#c4a7e7",
    "accent_foreground": "#191724",
    "solid": "#e0def4",
    "solid_foreground": "#191724",
    "ring": "#c4a7e7",
    "working": "#f6c177",
    "blocked": "#eb6f92",
    "done": "#9ccfd8",
    "idle": "#6e6a86",
    "unknown": "#6e6a86",
    "background": "#191724",
    "terminal_foreground": "#e0def4",
    "selection": "#403d52",
    "cursor": "#e0def4",
    "ansi0": "#26233a",
    "ansi1": "#eb6f92",
    "ansi2": "#31748f",
    "ansi3": "#f6c177",
    "ansi4": "#9ccfd8",
    "ansi5": "#c4a7e7",
    "ansi6": "#ebbcba",
    "ansi7": "#e0def4",
    "ansi8": "#6e6a86",
    "ansi9": "#eb6f92",
    "ansi10": "#31748f",
    "ansi11": "#f6c177",
    "ansi12": "#9ccfd8",
    "ansi13": "#c4a7e7",
    "ansi14": "#ebbcba",
    "ansi15": "#e0def4"
  },
  "preview": "layouts/rose-pine.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
